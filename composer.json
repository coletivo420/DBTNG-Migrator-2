{
  "name": "coletivo420/dbtng-migrator-2",
  "description": "Cross-database continuous standby and logical migration engine for Drupal with selectable MariaDB/MySQL or SQLite primary roles.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "drupal/core": "^11.4"
  },
  "require-dev": {
    "drupal/coder": "^9.0",
    "drush/drush": "^13.7 || ^14.0",
    "mglaman/phpstan-drupal": "^2.2",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\dbtng_migrator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drupal\\Tests\\dbtng_migrator\\": "tests/src/"
    }
  },
  "scripts": {
    "check": [
      "@validate",
      "@phpcs",
      "@phpstan",
      "@test"
    ],
    "validate": "composer validate --strict --no-check-publish",
    "phpcs": "phpcs --standard=phpcs.xml.dist src tests",
    "phpcbf": "phpcbf --standard=phpcs.xml.dist src tests",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "test": "phpunit --configuration=phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": false,
      "drupal/core-project-message": true,
      "drupal/core-recipe-unpack": true,
      "drupal/core-vendor-hardening": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "symfony/runtime": true,
      "tbachert/spi": false
    }
  }
}
