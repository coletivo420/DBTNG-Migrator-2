# Copy to an untracked, mode-0600 environment file or configure these
# values in the server/runtime environment. Never commit real credentials.

DBTNG_DEV_PRIMARY=mysql

DBTNG_MYSQL_HOST=localhost
DBTNG_MYSQL_PORT=3306
DBTNG_MYSQL_DATABASE=replace_with_virtualmin_database
DBTNG_MYSQL_USERNAME=replace_with_virtualmin_user
DBTNG_MYSQL_PASSWORD=replace_with_secret

DBTNG_SQLITE_DATABASE=/absolute/private/path/dbtng.sqlite
